<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.audiotriage.collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{AUDIO_TRIAGE_BIN}}</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{AUDIO_TRIAGE_ROOT}}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{AUDIO_TRIAGE_ROOT}}/var/collector.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{AUDIO_TRIAGE_ROOT}}/var/collector.stderr.log</string>
</dict>
</plist>
